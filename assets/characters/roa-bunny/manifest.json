{
  "$schema": "https://roa.app/schemas/character-manifest.json",
  "id": "roa-bunny",
  "name": "Roa Bunny",
  "version": "1.0.0",
  "author": "ROA Team",
  "description": "A cheerful, bouncy desktop companion rabbit who loves reminders and focus.",
  "preview": "preview.png",
  "personality": {
    "playful": 0.9,
    "calm": 0.5,
    "energetic": 0.8,
    "curious": 0.7
  },
  "animations": {
    "idle": {
      "file": "idle.png",
      "frames": 4,
      "frameRate": 4,
      "loop": true
    },
    "walking": {
      "file": "walk.png",
      "frames": 4,
      "frameRate": 6,
      "loop": true
    },
    "sleeping": {
      "file": "sleep.png",
      "frames": 2,
      "frameRate": 2,
      "loop": true
    },
    "happy": {
      "file": "happy.png",
      "frames": 4,
      "frameRate": 7,
      "loop": true
    },
    "thinking": {
      "file": "thinking.png",
      "frames": 3,
      "frameRate": 3,
      "loop": true
    },
    "reminding": {
      "file": "reminding.png",
      "frames": 4,
      "frameRate": 8,
      "loop": true
    },
    "celebrating": {
      "file": "celebrating.png",
      "frames": 4,
      "frameRate": 8,
      "loop": true
    }
  },
  "moods": ["idle", "happy", "sleeping", "thinking", "reminding", "celebrating"],
  "behaviors": {
    "idleIntervalMs": [4000, 12000],
    "walkProbability": 0.4,
    "walkDistancePx": [80, 220],
    "speechIntervalMs": [20000, 90000]
  }
}
